# Nexus360 Environment Configuration Example
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus360
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/nexus360

APP_NAME=Nexus360
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

MATCH_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60

# Market Intelligence API Key
MARKET_DATA_API_KEY=YOUR_MARKET_DATA_API_KEY
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_CONTENT_SID=OPTIONAL_TWILIO_CONTENT_SID

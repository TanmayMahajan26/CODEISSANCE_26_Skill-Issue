# ==============================================================================
# Nexus360 — Environment Configuration Template
# Copy this file to `.env` and configure for your local or cloud deployment.
# Do NOT commit production secrets or real passwords to version control.
# ==============================================================================

# ── Application & Environment ────────────────────────────────────────────────
APP_NAME=Nexus360
APP_VERSION=0.1.0
ENVIRONMENT=development  # "development" | "staging" | "production"
DEBUG=true               # Set to false in staging/production
LOG_LEVEL=INFO           # "DEBUG" | "INFO" | "WARNING" | "ERROR"

# ── Security & Authentication (JWT) ───────────────────────────────────────────
# MANDATORY IN PRODUCTION: Replace with a cryptographically random 32+ char secret.
# In development, a fallback secret is provided for rapid onboarding.
SECRET_KEY=nexus360-hackathon-super-secret-jwt-key-2026-financial-ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ── CORS Settings (Comma-separated list of allowed web origins) ───────────────
# Example: ["http://localhost:3000", "http://localhost:5173", "https://app.nexus360.com"]
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]

# ── File Upload & Ingestion Constraints ───────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10     # Maximum CSV upload size ceiling (DoS protection)
MAX_INGESTION_ROWS=25000  # Maximum records per batch upload

# ── Database Connection ───────────────────────────────────────────────────────
# Local PostgreSQL option:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword123@localhost:5432/nexus360
DATABASE_URL_SYNC=postgresql://postgres:postgrespassword123@localhost:5432/nexus360

# Supabase Remote PostgreSQL option (uncomment and replace credentials):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_URL_SYNC=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# SSL Verification (set to true in production with valid CA certs, false for self-signed/dev)
DB_SSL_VERIFY=false

# ── Identity Resolution Matching Thresholds (0.0 to 1.0) ──────────────────────
MATCH_THRESHOLD=0.85     # Score >= 0.85 -> AUTO MATCH & MERGE
REVIEW_THRESHOLD=0.60    # Score in [0.60, 0.85) -> FLAG FOR HUMAN REVIEW QUEUE
                         # Score < 0.60 -> NON_MATCH

# ── Matching Feature Weights (Must sum to 1.0) ────────────────────────────────
WEIGHT_PAN=0.35
WEIGHT_MOBILE=0.20
WEIGHT_EMAIL=0.15
WEIGHT_NAME=0.12
WEIGHT_NAME_SEMANTIC=0.08
WEIGHT_DOB=0.05
WEIGHT_CITY=0.03
WEIGHT_SEGMENT=0.02

# ── ML Embedding Configuration ────────────────────────────────────────────────
# Uses sentence-transformers ("all-MiniLM-L6-v2") locally.
# Falls back automatically to token overlap similarity if model download fails.
